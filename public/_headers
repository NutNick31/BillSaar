# Cloudflare Pages headers. https://developers.cloudflare.com/pages/configuration/headers/
# HTML keeps Cloudflare's default short cache (max-age=0, must-revalidate). Repeating Cache-Control
# under /* would be comma-joined with the rules below, so it is only set for long-lived files.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/og.png
  Cache-Control: public, max-age=86400
