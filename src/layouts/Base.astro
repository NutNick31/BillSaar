---
import '../styles/global.css';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import UnverifiedBanner from '../components/UnverifiedBanner.astro';
import { SITE, ROUTES, type Crumb } from '../site';
import { abs, breadcrumbLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  crumbs: Crumb[];
  jsonLd?: object[];
  /** Pass false to show the "being verified" banner. Omit on pages that show no tariff data. */
  dataVerified?: boolean;
  noindex?: boolean;
}

const { title, description, path, crumbs, jsonLd = [], dataVerified, noindex = false } = Astro.props;
const site = Astro.site;
const canonical = abs(path, site);
const ogImage = abs(SITE.ogImage, site);
const ld = [breadcrumbLd(crumbs, site), ...jsonLd];
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="utBSMP_2BT5YqWwpBagTA49aKKYFKhsPqNL1iVvwMAU" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f7f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121417" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={ROUTES.home}>
          <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="#0a58a8"></rect>
            <path d="M18 4 8 18h7l-2 10 11-15h-7z" fill="#f5b400"></path>
          </svg>
          <span class="brand-full">{SITE.name}</span>
          <span class="brand-short">{SITE.shortName}</span>
        </a>
        <nav class="header-nav" aria-label="Main">
          <a href={ROUTES.bescomCalculator}>Calculator</a>
          <a class="hide-sm" href={ROUTES.bescomRate}>Rates</a>
          <a class="hide-sm" href={ROUTES.gruhaJyothi}>Gruha Jyothi</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      {crumbs.length > 1 && <Breadcrumbs crumbs={crumbs} />}
      {dataVerified === false && <UnverifiedBanner />}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Footer">
          <ul>
            <li><a href={ROUTES.bescomCalculator}>BESCOM bill calculator</a></li>
            <li><a href={ROUTES.bescomRate}>BESCOM per unit rate</a></li>
            <li><a href={ROUTES.gruhaJyothi}>Gruha Jyothi calculator</a></li>
            <li><a href={ROUTES.howToRead}>How to read your bill</a></li>
            <li><a href={ROUTES.fppca}>FPPCA &amp; true-up</a></li>
            <li><a href={ROUTES.about}>About</a></li>
          </ul>
        </nav>
        <p class="disclaimer">
          This is an estimate based on the published tariff. Your actual bill may differ. Always check your official BESCOM bill. Not
          affiliated with BESCOM or KERC.
        </p>
      </div>
    </footer>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const root = document.documentElement;
      const isDark = () =>
        root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      const label = () => btn?.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme');
      label();
      btn?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        label();
      });
    </script>
  </body>
</html>
